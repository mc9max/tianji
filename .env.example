# Tianji environment variables
# Copy this file to .env and fill in your values

# PostgreSQL connection (required)
# On Railway, these are auto-wired from the companion postgres service.
DATABASE_URL="postgresql://tianji:***@localhost:5432/tianji"

# JWT signing (required)
JWT_SECRET="replace-with-a-random-string"

# Feature flags
ALLOW_REGISTER="false"
ALLOW_OPENAPI="true"

# Public URL (optional - auto-filled on Railway)
PUBLIC_URL="https://your-domain.com"

# Self-tracking (optional)
WEBSITE_ID=""

# JWT claims (optional)
JWT_ISSUER=""
JWT_AUDIENCE=""

# ClickHouse (optional - for analytics storage)
CLICKHOUSE_URL=""
CLICKHOUSE_USER=""
CLICKHOUSE_PASSWORD=""
CLICKHOUSE_DATABASE=""
